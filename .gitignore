# ── Node / Angular ────────────────────────────────────────────────────────────
node_modules/
frontend/dist/
frontend/.angular/
frontend/.cache/

# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.pyo
.venv/
venv/
env/
.env
*.egg-info/
dist/
build/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── ML models (large binary files) ───────────────────────────────────────────
backend/models/*.pkl
backend/models/*.joblib
*.pkl
*.joblib

# ── Large dataset CSV / data files ───────────────────────────────────────────
backend/data/**/*.csv
backend/data/**/*.log
backend/data/**/*.gz
backend/data/**/*.zip
backend/data/*.csv

# ── SQLite database files ─────────────────────────────────────────────────────
*.db
*.sqlite
*.sqlite3

# Keep the stats cache (small JSON, useful for everyone)
!backend/data/stats_cache.json

# ── IDE / editor ──────────────────────────────────────────────────────────────
.vscode/
.idea/
*.swp
*.swo
*~

# ── OS files ──────────────────────────────────────────────────────────────────
.DS_Store
.DS_Store?
Thumbs.db
ehthumbs.db
Desktop.ini

# ── Claude Code workspace ─────────────────────────────────────────────────────
.claude/

# ── Logs ──────────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Misc ──────────────────────────────────────────────────────────────────────
*.tmp
*.bak
.env.local
.env.production

# ── Paper experiments: transient artefacts ───────────────────────────────────
backend/experiments/results/pdfpages/
backend/experiments/results/*.log
backend/experiments/_*.py
